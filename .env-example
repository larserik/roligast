# Where the sign-in codes are sent from. Copy to .env and fill in.
# Leave SMTP_HOST empty and the code is written to the container log instead,
# which is how to sign in while developing.
SMTP_HOST=mail.netix.se
SMTP_PORT=587
SMTP_USER=roligast@mail.netix.se
SMTP_PASS=
SMTP_FROM=Roligast <info@roligast.com>
