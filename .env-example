# Where the sign-in codes are sent from. Copy to .env and fill in.
# Leave SMTP_HOST empty and the code is written to the container log instead,
# which is how to sign in while developing.
SMTP_HOST=mail.netix.se
SMTP_PORT=587
SMTP_USER=roligast@mail.netix.se
SMTP_PASS=
SMTP_FROM=Roligast <info@roligast.com>

# What to do about a sign-in request that carries a mark. off records the marks
# and nothing else; report also notes what it would have withheld and sends the
# code anyway; on withholds it. Start on report and read
# ./scripts/logins.sh signals before changing it.
SUPPRESS_SIGNINS=report
# Which marks would act. tor is refused here on purpose - it says how someone
# reached the site, not whether they are a person.
SUPPRESS_ON=quoted_ua

# The one hostname the site answers on. www.roligast.com and anything else then
# redirects here, which is what keeps a session from being split across two
# hosts. Leave empty when browsing the container by address.
CANONICAL_HOST=roligast.com
