<%- include("partials/header", { title: t("login_title") }) %>

<div class="form-box auth-box">
  <h1><%= t("login_title") %></h1>
  <p class="lead"><%= t("login_intro") %></p>
  <% if (error) { %><p class="error"><%= error %></p><% } %>

  <form action="/login" method="post" class="stacked">
    <input type="hidden" name="next" value="<%= next %>">
    <label for="email"><%= t("field_email") %></label>
    <input id="email" name="email" type="email" required autofocus
           autocomplete="email" inputmode="email" autocapitalize="none"
           autocorrect="off" spellcheck="false"
           value="<%= email %>" placeholder="<%= lang === "sv" ? "du@exempel.se" : "you@example.com" %>">
    <%# Safari on iOS offers the address from the contact card only when the
        form holds more than this one field; on its own it reads as a search
        box and nothing is offered. The field below exists to satisfy that. It
        keeps its default padding and border on purpose - zeroing them, like
        display:none, switches the suggestion off again - and it has no name,
        which keeps it out of what the form submits. %>
    <input tabindex="-1" aria-hidden="true" style="position:absolute; width:0px; height:0px; opacity:0; pointer-events:none;">

    <label class="checkbox">
      <input type="checkbox" name="remember" value="1" <%= remember ? "checked" : "" %>>
      <%= t("remember_email") %>
    </label>

    <button class="btn btn-primary btn-lg" type="submit"
            data-loading-text="<%= t("sending_code") %>"><%= t("send_code") %></button>
  </form>
  <p class="help"><%= t("login_why") %></p>
</div>

<%- include("partials/footer") %>
